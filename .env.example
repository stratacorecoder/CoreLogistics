# CoreLogistics does not load this file automatically. Set these in your shell
# (or your process manager) to override the defaults.

# API
PORT=3100
LOG_LEVEL=info
# Absolute path; defaults to apps/api/data
# CORELOGISTICS_DATA_DIR=
CORELOGISTICS_DB=corelogistics.db
# Demo sites, demo logins, and moving stale open jobs onto today.
# npm run dev passes --demo. Production stays off unless this is 1.
# CORELOGISTICS_DEMO=0
# Local model that phrases copilot answers. 0 skips it and returns the record text.
# CORELOGISTICS_OLLAMA=0
# CORELOGISTICS_OLLAMA_URL=http://127.0.0.1:11434
# CORELOGISTICS_OLLAMA_MODEL=qwen3.5:9b

# Apps (read at build/dev time by Vite)
VITE_API_URL=http://localhost:3100
