# CoreLogistics does not load this file automatically. Set these in your shell
# (or your process manager) to override the defaults.

# API
PORT=3100
LOG_LEVEL=info
# Absolute path; defaults to apps/api/data
# CORELOGISTICS_DATA_DIR=
CORELOGISTICS_DB=corelogistics.db
# Set to 1 behind Caddy or another TLS reverse proxy
# CORELOGISTICS_TRUST_PROXY=1
# Comma-separated extra CORS origins beyond localhost:5180-5183
# CORELOGISTICS_CORS_ORIGINS=

# Set to 1 to seed demo users on API startup even in production (never overwrites existing passwords)
# CORELOGISTICS_SEED_DEMO_USERS=1

# Apps (read at build/dev time by Vite)
VITE_API_URL=http://localhost:3100
# Set to 1 to show 1-click demo account quick-fill buttons in production builds
# VITE_DEMO_ACCOUNTS=1
# Optional subpath overrides for single-origin builds (used by Dockerfile)
# VITE_BASE_PATH=/
# VITE_ROLE_ROUTING=path

# Docker Compose host ports
# CORELOGISTICS_HTTP_PORT=8080
# CORELOGISTICS_HTTPS_PORT=8443
# CORELOGISTICS_API_PORT=3100
