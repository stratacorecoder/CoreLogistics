# CoreLogistics does not load this file automatically. Set these in your shell
# (or your process manager) to override the defaults.

# API
PORT=3100
LOG_LEVEL=info
# Absolute path; defaults to apps/api/data
# CORELOGISTICS_DATA_DIR=
CORELOGISTICS_DB=corelogistics.db

# Apps (read at build/dev time by Vite)
VITE_API_URL=http://localhost:3100
